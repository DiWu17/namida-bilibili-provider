 Future<void> onItemPlayOnlinePlayable<Q extends Playable>(
   Q pi,
   OnlinePlayable item,
   int index,
   Function skipItem, {
   required ItemPreparedPlayerInfo<Q>? preparedItemInfo,
 }) async {
   final resolver = OnlineMediaResolverRegistry.instance.resolverFor(item);
   if (resolver == null) return;
 
   final playback = await resolver.resolvePlayback(item);
   final video = chooseBestVideo(playback.videoStreams);
   final audio = chooseBestAudio(playback.audioStreams);
 
   if (audio == null) return;
 
   final audioSource = AudioVideoSource.uri(
     audio.url,
     headers: audio.headers,
   );
 
   final videoSource = video == null
       ? null
       : AudioVideoSource.uri(
           video.url,
           headers: video.headers,
         );
 
   await setSource(
     audioSource,
     index: currentIndex.value,
     item: pi,
     initialPosition: await _getItemInitialPosition(pi, playback.media.duration),
     videoOptions: videoSource == null
         ? null
         : VideoSourceOptions(
             source: videoSource,
             loop: false,
             videoOnly: false,
           ),
   );
 }

